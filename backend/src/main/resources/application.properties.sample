# [필독] 이 파일을 복사하여 application.properties로 이름을 바꾼 뒤 사용하세요.
# .gitignore에 application.properties가 포함되어 있는지 꼭 확인하세요!

spring.application.name=oshiashi
server.port=9922

# MySQL 설정 (환경변수 DB_URL, DB_USERNAME, DB_PASSWORD를 설정하세요)
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# Flyway 설정
spring.flyway.enabled=true
# 기존에 워크벤치로 만든 테이블이 있어도 에러 없이 시작하게 해주는 옵션
spring.flyway.baseline-on-migrate=true

# JPA 설정
spring.jpa.show-sql=true

# DDL 자동생성/검증 설정
# Flyway를 사용하므로 엔티티-DB 구조 일치 여부만 검사하는 validate가 가장 안전합니다.
spring.jpa.hibernate.ddl-auto=validate

# Hibernate가 자동으로 생성할 sql의 포맷 설정
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
# 업로드 경로 (본인의 로컬 경로에 맞게 수정)
board.uploadPath=c:/MyProject/util/upload/

# Google Map API KEY setting
google.maps.api.key=YOUR_API_KEY_HERE

# Redis 설정(Redis 프로그램 접속용)
spring.data.redis.host=YOUR_REDIS_HOST
spring.data.redis.port=YOUR_REDIS_PORT

# 만약 Redis에 비밀번호를 설정했다면 추가 (없으면 생략)
# spring.data.redis.password=your_password

# TMDB API 설정
tmdb.api.key=your_api_key
# 텍스트 데이터
tmdb.api.base-url=your_base_url
# 이미지 서버/CDN
tmdb.api.image-url=your_image_url

# Google STMP 설정
spring.mail.host=smtp.gmail.com
spring.mail.port=your_port
spring.mail.username=your_google_mail@gmail.com
spring.mail.password=your_password
# 사용자 인증 설정
spring.mail.properties.mail.smtp.auth=true
# 통신 암호화 설정
spring.mail.properties.mail.smtp.starttls.enable=true
# debug시 발송 체크용
spring.mail.properties.mail.debug=true

# Swagger UI 접속 경로 설정
springdoc.swagger-ui.path=/swagger-ui.html
# API 문서(JSON) 생성 경로
springdoc.api-docs.path=/api-docs
# UI가 위에서 설정한 /api-docs 경로를 바라보게 설정
springdoc.swagger-ui.config-url=/api-docs/swagger-config
# HTTP 메서드 순서대로 정렬 (GET, POST, PUT, DELETE 순)
springdoc.swagger-ui.operations-sorter=method
# 태그(컨트롤러) 정렬
springdoc.swagger-ui.tags-sorter=alpha
# 응답 소요 시간 표시
springdoc.swagger-ui.display-request-duration=true
# API 문서 스캔 범위
springdoc.packages-to-scan=project.oshiashi.oshiashi
