VITE_GOOGLE_MAPS_API_KEY=your_api_key_here
VITE_GOOGLE_MAP_ID=your_map_id_here

# API 엔드포인트 (백엔드 연결용)
# 나중에 Postman 테스트나 실제 DB에 핀 저장할 때 사용합니다.
VITE_API_BASE_URL=your_url/api/v1

# 지도 기본 설정 (하드코딩 방지)
# 성지순례 주 무대인 도쿄로 기본 좌표를 고정해두면 관리가 편합니다.
VITE_DEFAULT_LAT=35.6812
VITE_DEFAULT_LNG=139.7671
VITE_DEFAULT_ZOOM=11